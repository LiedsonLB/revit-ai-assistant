# Banco
POSTGRES_USER=revit_ai
POSTGRES_PASSWORD=revit_ai
POSTGRES_DB=revit_ai

# LLM — defina apenas o provider que for usar (backend/app/config.py)
LLM_PROVIDER=anthropic          # anthropic | openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Embeddings locais (sentence-transformers) — troque em app/rag/embeddings.py se preferir API
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Bridge C# do Revit (roda fora do Docker, na máquina com Revit)
REVIT_BRIDGE_URL=http://host.docker.internal:5005

# Frontend
VITE_API_URL=http://localhost:8000
